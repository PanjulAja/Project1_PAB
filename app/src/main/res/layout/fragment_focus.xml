<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fz_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:padding="4dp">

            <Button
                android:id="@+id/btn_focus_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Fokus 25m"
                android:textColor="@color/fz_mint"
                android:textAllCaps="false"
                android:backgroundTint="@color/fz_surface_light" />

            <Button
                android:id="@+id/btn_break_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Rehat 5m"
                android:textColor="@color/fz_text"
                android:textAllCaps="false"
                android:backgroundTint="@color/fz_surface" />

            <Button
                android:id="@+id/btn_long_break_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Panjang 15m"
                android:textColor="@color/fz_text"
                android:textAllCaps="false"
                android:backgroundTint="@color/fz_surface" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:layout_gravity="center"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="35dp"
            android:background="@drawable/bg_timer_ring">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● SESI 1 DARI 4"
                    android:textColor="@color/fz_mint"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="25:00"
                    android:textColor="@color/fz_text"
                    android:textSize="52sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_timer_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ruang Fokus Penuh"
                    android:textColor="@color/fz_muted"
                    android:textSize="16sp" />

            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="▤"
                android:textSize="26sp"
                android:textColor="@color/fz_mint"
                android:background="@drawable/bg_pill" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUGAS SEKARANG"
                    android:textColor="@color/fz_mint"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_current_task"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bab 3: Algoritma &amp; Struktur Data"
                    android:textColor="@color/fz_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:text="↻"
                android:textSize="24sp"
                android:textColor="@color/fz_muted"
                android:backgroundTint="@color/fz_surface" />

            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:text="▶  Mulai"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/fz_background"
                android:textAllCaps="false"
                android:backgroundTint="@color/fz_mint_dark" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:text="⏭"
                android:textColor="@color/fz_muted"
                android:backgroundTint="@color/fz_surface" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☁ Ambience\nSuara Hujan"
                android:textColor="@color/fz_text"
                android:textSize="15sp"
                android:background="@drawable/bg_card" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="⊖ Gangguan\nDND Aktif  ●"
                android:textColor="@color/fz_mint"
                android:textSize="15sp"
                android:background="@drawable/bg_card" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="20dp"
            android:text="♧  Ritme Belajar Stabil\nTuntaskan 1 sesi lagi sebelum jeda peregangan mata."
            android:textColor="@color/fz_text"
            android:textSize="15sp"
            android:background="@drawable/bg_card" />

    </LinearLayout>
</ScrollView>
